---
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import CardProject from "../../components/html/body/CardProject.astro";
import Title from "../../components/Title.astro";

const allProjects = await getCollection("projects");
const generalProjects = allProjects.filter(
  (project) => project.data.category === "general",
);
const categories = await getCollection("categories");

const localImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/**/*.{jpg,jpeg,png,webp,svg}",
  { eager: true },
);

const orderGeneralProjects = [...generalProjects].sort((a, b) => {
  if (a.data.dev === b.data.dev) return 0;
  return a.data.dev ? 1 : -1;
});

function resolveImage(path: string) {
  if (path.startsWith("/src/assets/")) {
    const found = localImages[path];
    if (!found) throw new Error(`Image ${path} not found in assets folder.`);
    return found.default; // objeto ImageMetadata real
  }
  return path; // URL remota, se queda como string
}
---

<section class="mt-4 flex flex-col gap-4">
  <Title title="Mis proyectos" className="!mb-2" />
  <p>Estos son algunos de mis proyectos personales que he desarrollado.</p>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
    {
      orderGeneralProjects.map((project) => {
        return (
          <CardProject
            {...project.data}
            image={resolveImage(project.data?.image)}
          />
        );
      })
    }
    {
      categories.map((category) => {
        return (
          <CardProject
            slug={category.id}
            category={category.id}
            title={category.data.title}
            description={category.data.description}
            image={resolveImage(category.data.image)}
          />
        );
      })
    }
  </div>
</section>
