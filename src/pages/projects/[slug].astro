---
import type { GetStaticPaths, ImageMetadata } from "astro";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import Header from "../../components/experience/Header.astro";
import Link from "../../components/ui/Link.astro";
import IconGoToPage from "../../Icons/IconGoToPage.astro";
import IconGithub from "../../Icons/IconGithub.astro";
import GalleryMasonry from "../../components/ui/GalleryMasonry.astro";
import { Image, getImage } from "astro:assets";
import { resolveVideo } from "../../utils/index";

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects");
  const generalProjects = projects.filter((p) => p.data.category === "general");

  return generalProjects.map((project: any) => {
    return {
      params: {
        slug: project.data.slug,
      },
      props: { ...project.data },
    };
  });
}) satisfies GetStaticPaths;

const { title, description, image, video, url, code, images } = Astro.props;

const localImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/**/*.{jpg,jpeg,png,webp,svg}",
  { eager: true },
);

function resolveImage(path: string): ImageMetadata | string {
  if (path.startsWith("/src/assets/")) {
    const found = localImages[path];
    if (!found) throw new Error(`Image ${path} not found in assets folder.`);
    return found.default; // objeto ImageMetadata real
    // return found.default.src; // URL remota, se queda como string
  }
  return path; // URL remota, se queda como string
}

const resolvedImages = images?.map((img: any) => ({
  ...img,
  src: resolveImage(img.src),
}));

const posterAsset = resolveImage(image);
const optimizedPoster = await getImage({
  src: posterAsset as ImageMetadata,
  width: 720,
  height: 405,
  format: "webp",
});

// console.log(title);
// console.log(images);

console.log("video del frontmatter:", video);
console.log("URL resuelta:", resolveVideo(video));
---

<Layout>
  <Header />
  <article class="flex flex-row gap-4 flex-wrap">
    <div class="basis-96 grow flex flex-col gap-4">
      <h1
        transition:name={`title-project-${title}`}
        class="font-semibold text-2xl text-yellowColor"
      >
        {title}
      </h1>
      <p
        transition:name={`description-project-${title}`}
        class="text-pretty text-_step1 font-normal text-gray-400 dark:text-gray-600"
      >
        {description}
      </p>

      <footer class="flex flex-row flex-wrap gap-2">
        {
          url && (
            <Link href={url} className="hover:text-yellowColor text-_step1">
              Sitio <IconGoToPage size="24" />
            </Link>
          )
        }
        {
          code && (
            <Link href={code} className="hover:text-yellowColor text-_step1">
              Código <IconGithub size="24" />
            </Link>
          )
        }
      </footer>
    </div>
    <div class="cover w-full max-w-lg aspect-video rounded-md overflow-hidden">
      <!-- <img src={image} alt={title} transition:name={`image-project-${title}`} /> -->
      {
        !video ? (
          <Image
            src={resolveImage(image) as string}
            alt={title}
            transition:name={`image-project-${title}`}
            width={1280}
            height={720}
            class="w-full h-full object-cover object-left-top"
          />
        ) : (
          <div class="relative w-full h-full overflow-hidden">
            <video
              data-project-video
              poster={optimizedPoster.src}
              src={resolveVideo(video) as string}
              autoplay
              muted
              loop
              controls
              playsinline
              preload="auto"
              class="w-full h-full object-cover object-top"
            />
            {/* <div
              data-video-loader
              class="loader w-full flex flex-col pt-4 gap-1 items-center absolute bottom-0 inset-x-0 z-10 bg-gradient-to-t from-black/50 to-transparent transition-opacity duration-300"
            >
              <p class="text-_step2 text-gray-100 w-full flex flex-row gap-2 justify-between px-2">
                <span>Cargando video...</span>
                <span data-video-percent>0%</span>
              </p>
              <progress
                data-video-progress
                max="100"
                value="0"
                class="h-1 rounded-sm w-full"
              />
            </div> */}
          </div>
        )
      }
    </div>
  </article>
  <GalleryMasonry images={resolvedImages} />
</Layout>

<style>
  [data-video-progress] {
  }
  /* Color de fondo de la barra (la pista vacía) */
  [data-video-progress]::-webkit-progress-bar {
    background-color: var(--color-gray-dark); /* Gris claro (ej. gray-200) */
  }
  /* Color del progreso (el relleno rojo) */
  [data-video-progress]::-webkit-progress-value {
    background-color: var(--color-body); /* Rojo red-500 */
  }
  /* Para Firefox */
  [data-video-progress]::-moz-progress-bar {
    background-color: var(--color-body);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const $video = document.querySelector(
      "[data-project-video]",
    ) as HTMLVideoElement | null;
    if (!$video) return;
    if ($video.readyState === 0) {
      $video.load();
    }

    $video.addEventListener("canplay", () => {
      $video.play().catch((e) => {
        console.log("Error al reproducir el video:", e);
      });
    });
  });
</script>

