---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/experience/Header.astro";

export async function getStaticPaths() {
  const allProjects = await getCollection("projects");
  const categories = await getCollection("categories");
  console.log(categories);

  return categories.map((cat: any) => {
    const projectsInCategory = allProjects.filter(
      (project) => project.data.category === cat.data.id,
    );
    return {
      params: {
        category: cat.data.id,
      },
      props: {
        category: { ...cat.data },
        projects: projectsInCategory,
      },
    };
  });
}

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/**/*.{jpg,jpeg,png,webp,svg}",
  // { eager: true },
);
const { category, projects } = Astro.props;
const { title, description, image } = category;

if (!images[image])
  throw new Error(`Image ${image} not found in the assets folder.`);
---

<Layout>
  <Header />
  <article class="flex flex-row gap-4 flex-wrap">
    <div class="basis-96 grow flex flex-col gap-4">
      <h1
        transition:name={`title-category-${title}`}
        class="font-semibold text-2xl md:text-4xl text-yellowColor"
      >
        {title}
      </h1>
      <p
        transition:name={`description-category-${title}`}
        class="text-pretty text-_step1 font-normal text-gray-400 dark:text-gray-600"
      >
        {description}
      </p>
    </div>
    <div class="cover w-full max-w-lg overflow-hidden">
      <!-- <img
        src={image}
        alt={title}
        transition:name={`image-category-${title}`}
      /> -->
      <!-- <Image
        src={images[image]()}
        alt={title}
        transition:name={`image-category-${title}`}
        class="w-full h-full object-cover object-center"
      /> -->
    </div>
  </article>
  <section class="projects grid grid-cols-1 gap-4">
    <article class="flex flex-row gap-4 flex-wrap">
      <div class="content flex flex-col gap-4 bg-red-300 grow basis-96">
        <h2>Proyecto X</h2>
        <p>Lorem ipsum dolor</p>
      </div>
      <figure class="cover
        w-full
        max-w-md">
        <img
          src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRST2yYNKLe60143E__1ErbJazMQTXphwOHp0FEp5lG0DpTnUMto5niHvxl&s=10"
          alt="Project X"
        />
      </figure>
    </article>
    <article class="flex flex-row-reverse gap-4 flex-wrap">
      <div class="content flex flex-col gap-4 bg-green-300 grow basis-96">
        <h2>Proyecto X</h2>
        <p>Lorem ipsum dolor</p>
      </div>
      <figure class="cover
        w-full
        max-w-md">
        <img
          src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRST2yYNKLe60143E__1ErbJazMQTXphwOHp0FEp5lG0DpTnUMto5niHvxl&s=10"
          alt="Project X"
        />
      </figure>
    </article>
  </section>
  {JSON.stringify(category, null, 2)}
  {JSON.stringify(projects, null, 2)}
</Layout>
