---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/experience/Header.astro";
import Link from "../../../components/ui/Link.astro";
import IconGoToPage from "../../../Icons/IconGoToPage.astro";
import IconGithub from "../../../Icons/IconGithub.astro";

export async function getStaticPaths() {
  const allProjects = await getCollection("projects");
  const categories = await getCollection("categories");
  console.log(categories);

  return categories.map((cat: any) => {
    const projectsInCategory = allProjects.filter(
      (project) => project.data.category === cat.data.id,
    );
    return {
      params: {
        category: cat.data.id,
      },
      props: {
        category: { ...cat.data },
        projects: projectsInCategory,
      },
    };
  });
}

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/**/*.{jpg,jpeg,png,webp,svg}",
  { eager: true },
);
const { category, projects } = Astro.props;
const { title, description, image } = category;

// if (!images[image])
//   throw new Error(`Image ${image} not found in the assets folder.`);

function isLocalAsset(url: string): boolean {
  return url.startsWith("/") && url.startsWith("/src/assets/images/");
}

if (isLocalAsset(image) && !images[image]) {
  throw new Error(`Image ${image} not found in the assets folder.`);
}
---

<Layout>
  <Header />
  <article class="flex flex-row gap-4 flex-wrap">
    <div class="basis-96 grow flex flex-col gap-4">
      <h1
        transition:name={`title-project-${title}`}
        class="font-semibold text-2xl md:text-4xl text-yellowColor"
      >
        {title}
      </h1>
      <p
        transition:name={`description-project-${title}`}
        class="text-pretty text-_step1 font-normal text-gray-400 dark:text-gray-600"
      >
        {description}
      </p>
    </div>
    <div class="cover w-full max-w-lg overflow-hidden">
      <!-- <img
        src={image}
        alt={title}
        transition:name={`image-project-${title}`}
      /> -->
      <!-- <Image
        src={images[image]()}
        alt={title}
        transition:name={`image-project-${title}`}
        class="w-full h-full object-cover object-center"
      /> -->
    </div>
  </article>
  <section class="projects grid grid-cols-1 gap-4">
    {
      projects.map((project, index) => {
        const {
          title,
          description,
          url,
          code,
          image: projectImage,
        } = project.data;

        return (
          <article
            class={`flex ${index % 2 === 0 ? "flex-row" : "flex-row-reverse"} gap-4 flex-wrap`}
          >
            <div class="content flex flex-col gap-4 grow basis-96">
              <h2 class="text-3xl font-extrabold">{title}</h2>
              <p>{description}</p>
              <div class="actions flex flex-row gap-2">
                {url && (
                  <Link
                    href={url}
                    className="hover:text-yellowColor text-_step1"
                  >
                    Sitio <IconGoToPage size="24" />
                  </Link>
                )}
                {code && (
                  <Link
                    href={code}
                    className="hover:text-yellowColor text-_step1"
                  >
                    Código <IconGithub size="24" />
                  </Link>
                )}
              </div>
            </div>
            <figure class="cover w-full max-w-md max-h-96 aspect-square">
              {isLocalAsset(projectImage) && images[projectImage] ? (
                <Image
                  src={images[projectImage].default}
                  alt={title}
                  transition:name={`image-project-${title}`}
                  class="w-full h-auto aspect-video"
                />
              ) : (
                <img
                  src={projectImage}
                  alt={title}
                  transition:name={`image-project-${title}`}
                  class="w-full h-full object-cover object-center"
                />
              )}
            </figure>
          </article>
        );
      })
    }
  </section>
</Layout>
